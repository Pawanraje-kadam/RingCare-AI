# ---------------------------------------------------------------------------
# RingCare AI — environment variables
#
# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored and must never be committed.
#
# IMPORTANT: Do NOT prefix either variable with NEXT_PUBLIC_. Anything prefixed
# with NEXT_PUBLIC_ is bundled into browser JavaScript and would expose secrets.
# ---------------------------------------------------------------------------

# Your Google Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
# Leave empty to run in deterministic "rules-only" mode. The app still works.
GEMINI_API_KEY=

# Optional. Model used for server-side analysis.
# The app defaults to gemini-3.8-flash when this is empty.
# Model availability, free-tier access, and quotas change over time — verify the
# current list at https://ai.google.dev/gemini-api/docs/models and your limits at
# https://aistudio.google.com/rate-limit before changing this value.
GEMINI_MODEL=
