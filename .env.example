# ---------------------------------------------------------------------------
# RingCare AI — environment variables
#
# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored and must never be committed.
#
# IMPORTANT: Do NOT prefix either variable with NEXT_PUBLIC_. Anything prefixed
# with NEXT_PUBLIC_ is bundled into browser JavaScript and would expose secrets.
# ---------------------------------------------------------------------------

# Your Google Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
# Server-only. Leave empty to run in deterministic "rules-only" mode; the app
# still works. GOOGLE_API_KEY is also read as a fallback (the official SDK
# supports both names), but GEMINI_API_KEY takes precedence.
GEMINI_API_KEY=

# RingCare AI is pinned to Gemini 3.8 Flash (gemini-3.8-flash). Set this only
# to confirm the pinned model (with or without a "models/" prefix). A value that
# names a different model is ignored, and the Settings page reports that it was
# ignored.
GEMINI_MODEL=gemini-3.8-flash

# After changing environment variables on Vercel you must redeploy; existing
# deployments do not receive new values. Use Settings → AI analysis →
# "Test connection" to verify the key and model after deploying.
