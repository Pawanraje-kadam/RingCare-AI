# ---------------------------------------------------------------------------
# RingCare AI — environment variables
#
# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored and must never be committed.
#
# IMPORTANT: Do NOT prefix any of these variables with NEXT_PUBLIC_. Anything
# prefixed with NEXT_PUBLIC_ is bundled into browser JavaScript and would
# expose secrets.
# ---------------------------------------------------------------------------

# Your Groq API key from https://console.groq.com/keys
# Server-only. Leave empty to run in deterministic "rules-only" mode; the app
# still works and clearly labels every deterministic fallback.
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile. Any valid Groq model id may be
# used; the active model is reported by /api/health and shown on every AI
# result. An invalid value is ignored and reported in Settings.
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional. Defaults to https://api.groq.com/openai/v1 (the OpenAI-compatible
# endpoint). Set this only when routing through a proxy or a local mock.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# After changing environment variables on Vercel you must redeploy; existing
# deployments do not receive new values. Use Settings → AI analysis →
# "Test connection" to verify the key and model after deploying.
